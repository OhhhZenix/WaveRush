{
    "version": 2,
    "configurePresets": [
        {
            "name": "vcpkg-base",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": {
                    "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                    "type": "FILEPATH"
                }
            }
        },
        {
            "name": "default",
            "inherits": "vcpkg-base",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build"
        }
    ]
}